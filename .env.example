# Copy this file to .env and fill in your own keys.
# .env is gitignored — never commit real keys.

# https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=your_openweathermap_key_here

# Free live satellite data (NDVI/crop-stress/water-stress on the Maps
# page) via Sentinel Hub, now served through the Copernicus Data Space
# Ecosystem (CDSE) -- free tier, no credit card required:
#   1. Create an account at https://dataspace.copernicus.eu
#   2. Click your profile icon -> "Sentinel Hub" to open the Sentinel
#      Hub dashboard, then User Settings -> OAuth Clients -> create one
#   3. Copy the Client ID and Client Secret below
#   4. pip install -r requirements-optional.txt (installs the sentinelhub package)
# Without this, the app automatically falls back to synthetic NDVI/soil
# index values so it still runs -- this is purely an upgrade to live data.
SENTINEL_HUB_CLIENT_ID=your_oauth_client_id_here
SENTINEL_HUB_CLIENT_SECRET=your_oauth_client_secret_here
# Leave these two as-is unless Copernicus changes their endpoints --
# they must point at CDSE, not the legacy sentinel-hub.com service.
SENTINEL_HUB_BASE_URL=https://sh.dataspace.copernicus.eu
SENTINEL_HUB_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token

# Simpler alternative to Sentinel Hub: Agromonitoring (by OpenWeatherMap).
# One flat API key, no OAuth client, uses the `requests` package you
# already have -- no extra pip install needed. Free tier has a small
# polygon cap, so it's a good way to see live NDVI working quickly, but
# Sentinel Hub above scales better if you outgrow that cap.
#   1. Sign up at https://agromonitoring.com (or via your existing
#      OpenWeatherMap account)
#   2. Copy your API key below
# Used automatically as a fallback whenever Sentinel Hub isn't configured.
AGRO_API_KEY=your_agromonitoring_api_key_here

# Gemini API (for the Farmer Awareness Assistant). Get a key at
# https://aistudio.google.com/apikey -- without it, the Awareness page
# falls back to a static FAQ instead of a live chatbot.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# Optional free backup if Gemini is unavailable/deprecated again. Get a
# free key at https://console.groq.com/keys (no cost, generous free tier).
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Database: leave blank to use SQLite (default, zero setup, single-user).
# Set to a Postgres connection string (e.g. from a free Supabase project)
# to move to a real multi-user database -- no code changes needed, just
# install psycopg2-binary from requirements-optional.txt first.
# Example: postgresql://postgres:[password]@[host]:5432/postgres
#
# IMPORTANT for the admin/public split below: use the SAME Supabase URL
# here (your laptop's .env) and in the Render dashboard's DATABASE_URL
# for the deployed public app. That shared database is how student
# submissions reach your laptop and how your saved results reach students.
DATABASE_URL=

# --- Admin / Public mode (see README "Admin vs Public mode") ---
# APP_MODE=admin (or leave unset) -> full app, all pages, behind the
#   ADMIN_PASSWORD login below. Only set this locally, never on Render.
# APP_MODE=public -> students only see data-entry + read-only results
#   pages; ML/MOA never runs here. This is what render.yaml sets for
#   the deployed service -- don't set it in your local .env.
APP_MODE=admin

# Password for the admin login gate (only checked when APP_MODE=admin).
# Pick your own value -- this is not sent anywhere, just compared locally.
ADMIN_PASSWORD=change-me

